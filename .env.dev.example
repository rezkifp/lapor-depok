# Salin ke api/.env untuk development di PC. Nilai di bawah hanya untuk lokal, bukan produksi.
APP_ENV=development
DATABASE_URL=postgresql://lapor:lapor@localhost:5432/lapor
UPLOAD_DIR=./uploads
APP_BASE_URL=http://localhost:5173
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Fernet key dev (44 karakter). Buat baru: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NIK_ENC_KEY=
NIK_HASH_PEPPER=dev-only-pepper
# SMTP kosong = email tidak dikirim, isi tautan verifikasi/reset dicetak ke log API (agar bisa diuji tanpa email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
